# 复制为 .env 使用
# backend ↔ service 的内网令牌（唯一鉴权凭据，用户 key 由 backend 校验）
SERVICE_TOKEN=change-me

REDIS_URL=redis://redis:6379/0

# 注册表路径
MODELS_CONFIG=/app/models.yaml

# 解析任务队列上限（超过返回 429，由 backend 限流）
PARSE_QUEUE_MAX=200
# VQA 同步通道并发上限
VQA_MAX_CONCURRENCY=8

# 结果暂存时长（秒），backend 需在此期限内取回归档
RESULT_TTL=86400
