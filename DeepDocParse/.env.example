# 复制为 .env 使用
# backend ↔ service 的内网令牌（唯一鉴权凭据，用户 key 由 backend 校验）
SERVICE_TOKEN=change-me

REDIS_URL=redis://redis:6379/0

# corpus MCP 直接读共享 PostgreSQL/MinIO。容器部署时 host.docker.internal
# 由 compose 映射到宿主机；宿主机进程改成 127.0.0.1。
CORPUS_DATABASE_URL=postgresql+asyncpg://ddp:ddp@host.docker.internal:15432/deepdocparse
MINIO_ENDPOINT=http://host.docker.internal:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=deepdocparse
MCP_MIN_SIMILARITY=0.55
# 对外站点根地址；留空时 crop_url 为同源相对路径（推荐经 Web /mcp 代理访问）。
MCP_PUBLIC_BASE_URL=

# 注册表路径
MODELS_CONFIG=/app/models.yaml

# 解析任务队列上限（超过返回 429，由 backend 限流）
PARSE_QUEUE_MAX=200
# 在途任务在水位集合里的存活上限（秒）。worker 最迟在 POLL_TIMEOUT 判失败并释放，
# 超过它还挂着的一定是释放丢了（worker 被杀/Redis 重启）——淘汰掉水位才能自愈，
# 否则 /v1/parse 会永久 429。应保持 > POLL_TIMEOUT。
QUEUE_INFLIGHT_TTL=2400
# VQA 同步通道并发上限
VQA_MAX_CONCURRENCY=8

# 结果暂存时长（秒），backend 需在此期限内取回归档
RESULT_TTL=86400
