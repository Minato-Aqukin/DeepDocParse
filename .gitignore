# 环境与密钥。**这几行是安全边界，不是整洁问题** ——
# infra/env/dev.env 里有 JWT_SECRET / SERVICE_TOKEN / 对象存储密钥，
# 提交进去等于把整套鉴权公开。`scripts/dev.sh secrets` 生成它并 chmod 600，
# `tests/test_architecture_guards.py` 有一条守卫钉着它必须被忽略。
.env
.env.local
.env.*.local
/infra/env/*.env
!/infra/env/*.env.example

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
.ruff_cache/

# Node / 前端
node_modules/
dist/
.quickstart/

# 前端测试产物（Playwright）。**必须忽略**：失败用例的 trace 里带着
# 完整页面快照与网络记录，体积大且可能含本机路径
test-results/
playwright-report/
blob-report/
.playwright/

# Go。**两个二进制名与包目录同名**（`go build ./cmd/control-api` 缺省就
# 落在仓库里），一次 `git add -A` 就是 35MB 进历史。有守卫钉着这三条
/services/control-api/bin/
/services/control-api/control-api
/services/control-api/control-migrate
*.test

# 评测与迁移产物
.eval-cache/
/eval/out/
/database/migrator/out/

# 运行日志
.dev-logs/
