# Local recipe for the reviewed directory artifact; no AUR publication or updater claim.
pkgname=deepdocparse-desktop-spike
pkgver=0.1.0
pkgrel=1
pkgdesc='DeepDocParse shared Vue desktop host (integration spike)'
arch=('x86_64')
url='https://github.com/Minato-Aqukin/DeepDocParse'
license=('Apache-2.0' 'MIT' 'BSD-3-Clause')
depends=('python>=3.14' 'python<3.15' 'alsa-lib' 'at-spi2-core' 'cairo' 'libcups'
         'dbus' 'expat' 'fontconfig' 'freetype2' 'glib2' 'glibc' 'gtk3' 'libdrm'
         'libx11' 'libxcb' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes'
         'libxkbcommon' 'libxrandr' 'mesa' 'nspr' 'nss' 'pango' 'systemd-libs' 'zlib')
options=('!strip')
# scripts/build_desktop_arch.sh replaces this template with exact local input SHA256s.
source=('deepdocparse-0.1.0-linux-x64.tar.gz' 'deepdocparse.desktop' 'deepdocparse')
sha256sums=('BUILD_SCRIPT_MUST_SET_SHA256' 'BUILD_SCRIPT_MUST_SET_SHA256' 'BUILD_SCRIPT_MUST_SET_SHA256')

package() {
    install -d "$pkgdir/opt/deepdocparse"
    cp -a "$srcdir/deepdocparse-0.1.0-linux-x64/." "$pkgdir/opt/deepdocparse/"
    install -Dm755 "$srcdir/deepdocparse" "$pkgdir/usr/bin/deepdocparse"
    install -Dm644 "$srcdir/deepdocparse.desktop" "$pkgdir/usr/share/applications/deepdocparse.desktop"
    install -Dm644 "$pkgdir/opt/deepdocparse/LICENSE.DeepDocParse" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    # User namespaces keep Chromium sandboxed. Do not add --no-sandbox or a setuid fallback.
    chmod 755 "$pkgdir/opt/deepdocparse/chrome-sandbox"
}
