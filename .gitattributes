*.pdf binary
tests/fixtures/** binary

# Hash-pinned lock files keep LF on every checkout. The WSL runtime tarball
# embeds the sha256 of packaging/windows/wsl-runtime-lock.json and the Windows
# assembler re-hashes the in-repo copy; a CRLF checkout turns 57489d78 into
# 02961a3e and fails the pin comparison. Affects only hash-sensitive files.
packaging/windows/*.json text eol=lf
packaging/arch/*.json text eol=lf

# Submission manifests pin every delivered byte, including UTF-8 BOM/CRLF CSV.
# Disable checkout conversion for this frozen artifact directory only.
docs/competition/ai-race-908823941852692809/** -text
# The Excel-friendly timing CSV intentionally uses RFC 4180 CRLF records.
docs/competition/ai-race-908823941852692809/**/*.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
