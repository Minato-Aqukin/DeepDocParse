# 复制为 .env 使用（写文件时注意用 UTF-8，PowerShell 默认编码会写出 GBK/BOM）

# ---- 本层资源 ----
DATABASE_URL=postgresql+asyncpg://ddp:ddp@127.0.0.1:15432/deepdocparse
JWT_SECRET=change-me-please

POSTGRES_USER=ddp
POSTGRES_PASSWORD=ddp
POSTGRES_DB=deepdocparse

# MinIO：9000 被 gateway 占，Windows 保留段 7964-8063 也要避开
MINIO_INTERNAL_ENDPOINT=127.0.0.1:19000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=deepdocparse

# ---- 对 DeepDocParse（service）----
SERVICE_URL=http://127.0.0.1:9000
MCP_URL=http://127.0.0.1:9100
# 必须与 DeepDocParse/.env 里的 SERVICE_TOKEN 一致
SERVICE_TOKEN=change-me

# 解析必须走 service；embedding 与 chat 只要求 OpenAI 兼容，可直连别的服务。
# 留空则回落到 {SERVICE_URL}/v1/...，dev 下什么都不用配。
# EMBEDDING_URL=http://127.0.0.1:18080/v1/embeddings
# CHAT_URL=http://127.0.0.1:18001/v1/chat/completions

# ---- 检索与问答 ----
EMBEDDING_DIM=1024          # bge-m3。换模型维度变了要改这里并全量 reindex
EMBEDDING_BATCH_SIZE=16     # 必须低于运行时的 max-client-batch-size（TEI 默认 32）
CHUNK_MAX_CHARS=800
QA_TOP_K=4
QA_RATE_PER_MIN=20
# 出处的相关性下限。没有它，问一个与文档无关的问题也会拿到几条不相干的"出处"。
# 0.45 依据 bge-m3 实测（相关命中 0.72+，无关 0.25~0.38）；往上调安全，往下调会放进假出处
QA_MIN_SIMILARITY=0.45

# ---- 多副本（单实例可留空）----
# 配了才有跨副本共享的限速与对账选主
# REDIS_URL=redis://127.0.0.1:16379/0

# service 回访本服务的地址（稳定文件 URL 与解析回调都用它拼）。
# 宿主机混合模式用 127.0.0.1:8080；全容器部署改成服务名，如 http://web-backend:8080
PUBLIC_BASE_URL=http://127.0.0.1:8080

# ---- 归档与额度 ----
RESULT_TTL=86400          # 必须 <= service 的暂存窗口，否则结果取不回来
RECONCILE_INTERVAL=60
DEFAULT_QUOTA_PAGES=1000
DEFAULT_RATE_LIMIT_PER_MIN=60
