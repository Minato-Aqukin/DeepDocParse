{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepdocparse.dev/schemas/ddp-bundle/1",
  "title": "DDP-BUNDLE v1",
  "x-ddp-contract": "ddp-bundle/1",
  "$defs": {
    "BundleSource": {
      "type": "object",
      "description": "Immutable source identity and explicit original availability. These are transfer claims, not authorization credentials.",
      "properties": {
        "origin_node_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "authority_node_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source_version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "parse_revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "mime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "original": {
          "enum": [
            "present",
            "missing"
          ]
        },
        "missing_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "uploader_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "policy_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "origin_node_id",
        "authority_node_id",
        "resource_id",
        "source_version_id",
        "source_digest",
        "parse_revision",
        "filename",
        "mime",
        "original",
        "missing_reason",
        "uploader_ref",
        "policy_revision"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "original": {
                "const": "present"
              }
            }
          },
          "then": {
            "properties": {
              "missing_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "original": {
                "const": "missing"
              }
            }
          },
          "then": {
            "properties": {
              "missing_reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        }
      ]
    },
    "VersionFile": {
      "type": "object",
      "description": "One exact archive member. Runtime verifies its actual length and bytes against this digest.",
      "properties": {
        "path": {
          "enum": [
            "source.bin",
            "layout.json",
            "evidence.json",
            "provenance.json",
            "wiki.json",
            "vectors.json"
          ]
        },
        "role": {
          "enum": [
            "original",
            "layout",
            "evidence",
            "provenance",
            "wiki",
            "vectors"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "role",
        "size",
        "digest"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "path": {
                "const": "source.bin"
              }
            }
          },
          "then": {
            "properties": {
              "role": {
                "const": "original"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "const": "layout.json"
              }
            }
          },
          "then": {
            "properties": {
              "role": {
                "const": "layout"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "const": "evidence.json"
              }
            }
          },
          "then": {
            "properties": {
              "role": {
                "const": "evidence"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "const": "provenance.json"
              }
            }
          },
          "then": {
            "properties": {
              "role": {
                "const": "provenance"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "const": "wiki.json"
              }
            }
          },
          "then": {
            "properties": {
              "role": {
                "const": "wiki"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "const": "vectors.json"
              }
            }
          },
          "then": {
            "properties": {
              "role": {
                "const": "vectors"
              }
            }
          }
        }
      ]
    },
    "BundleManifest": {
      "type": "object",
      "description": "DDP-Bundle v1 root manifest. ZIP path/type/ratio limits and evidence byte/identity consistency are checked in addition to this schema.",
      "properties": {
        "schema": {
          "const": "ddp-bundle/1"
        },
        "required_features": {
          "type": "array",
          "items": {
            "enum": [
              "wiki",
              "vectors"
            ]
          },
          "maxItems": 2,
          "uniqueItems": true
        },
        "source": {
          "$ref": "#/$defs/BundleSource"
        },
        "files": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/VersionFile"
          },
          "uniqueItems": true,
          "allOf": [
            {
              "contains": {
                "properties": {
                  "path": {
                    "const": "layout.json"
                  }
                },
                "required": [
                  "path"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "path": {
                    "const": "evidence.json"
                  }
                },
                "required": [
                  "path"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "path": {
                    "const": "provenance.json"
                  }
                },
                "required": [
                  "path"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      },
      "required": [
        "schema",
        "required_features",
        "source",
        "files"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "properties": {
                  "original": {
                    "const": "present"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "files": {
                "minItems": 4,
                "contains": {
                  "properties": {
                    "path": {
                      "const": "source.bin"
                    }
                  },
                  "required": [
                    "path"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            }
          },
          "else": {
            "properties": {
              "files": {
                "maxItems": 5,
                "items": {
                  "properties": {
                    "path": {
                      "not": {
                        "const": "source.bin"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "required_features": {
                "contains": {
                  "const": "wiki"
                }
              }
            }
          },
          "then": {
            "properties": {
              "files": {
                "contains": {
                  "properties": {
                    "path": {
                      "const": "wiki.json"
                    }
                  },
                  "required": [
                    "path"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            }
          },
          "else": {
            "properties": {
              "files": {
                "not": {
                  "contains": {
                    "properties": {
                      "path": {
                        "const": "wiki.json"
                      }
                    },
                    "required": [
                      "path"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "required_features": {
                "contains": {
                  "const": "vectors"
                }
              }
            }
          },
          "then": {
            "properties": {
              "files": {
                "contains": {
                  "properties": {
                    "path": {
                      "const": "vectors.json"
                    }
                  },
                  "required": [
                    "path"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            }
          },
          "else": {
            "properties": {
              "files": {
                "not": {
                  "contains": {
                    "properties": {
                      "path": {
                        "const": "vectors.json"
                      }
                    },
                    "required": [
                      "path"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "BundleWiki": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "ddp-bundle-wiki/1"
        },
        "state": {
          "enum": [
            "draft",
            "empty"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "page_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "generated_sections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "heading": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 0,
                      "maxLength": 512
                    },
                    "claims": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "claim_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 10000
                          },
                          "evidence_ids": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "unsupported": {
                            "type": "boolean"
                          },
                          "conflict_group": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "minLength": 1
                          }
                        },
                        "required": [
                          "claim_id",
                          "text",
                          "evidence_ids",
                          "unsupported"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 100
                    }
                  },
                  "required": [
                    "heading",
                    "claims"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 50
              },
              "human_paragraphs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 10000
                    }
                  },
                  "required": [
                    "id",
                    "text"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 100
              }
            },
            "required": [
              "page_key",
              "title",
              "generated_sections",
              "human_paragraphs"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject_page": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "object_page": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "predicate": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "\\S"
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "unsupported": {
                "type": "boolean"
              }
            },
            "required": [
              "subject_page",
              "object_page",
              "predicate",
              "evidence_ids",
              "unsupported"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        },
        "dependency_manifest": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "page_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "excerpt_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "source": {
                "type": "object",
                "properties": {
                  "origin_node_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
                  },
                  "authority_node_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
                  },
                  "resource_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "source_version_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "source_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "parse_revision": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "required": [
                  "origin_node_id",
                  "authority_node_id",
                  "resource_id",
                  "source_version_id",
                  "source_digest",
                  "parse_revision"
                ],
                "additionalProperties": false
              },
              "source_evidence_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "locator": {
                "$ref": "../ddp-evidence/v1.json#/$defs/Locator"
              },
              "policy_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "review": {
                "enum": [
                  "available",
                  "needs_review",
                  "unavailable"
                ]
              }
            },
            "required": [
              "page_key",
              "evidence_id",
              "excerpt_digest",
              "source",
              "review"
            ],
            "allOf": [
              {
                "if": {
                  "properties": { "review": { "const": "available" } },
                  "required": ["review"]
                },
                "then": {
                  "properties": {
                    "source_evidence_id": false,
                    "locator": false,
                    "policy_revision": false
                  }
                }
              }
            ],
            "additionalProperties": false
          },
          "maxItems": 10000
        }
      },
      "required": [
        "schema",
        "state",
        "title",
        "pages",
        "reason"
      ],
      "additionalProperties": false,
      "description": "Private draft only. Runtime also validates page/claim identity uniqueness, relation endpoints, exact source/evidence/digest bindings and external dependencies requiring review. Human paragraph text is preserved verbatim.",
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "empty"
              }
            }
          },
          "then": {
            "properties": {
              "title": {
                "type": "null"
              },
              "pages": {
                "maxItems": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "relations": {
                "maxItems": 0
              },
              "dependency_manifest": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "pages": {
                "minItems": 1
              },
              "reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "BundleVectors": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "ddp-bundle-vectors/1"
        },
        "state": {
          "enum": [
            "present",
            "missing"
          ]
        },
        "model": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "dimension": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          },
          "required": [
            "name",
            "version",
            "dimension"
          ],
          "additionalProperties": false
        },
        "dimension": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4096
        },
        "preprocessing": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "tokenizer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "normalization": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "tokenizer",
            "normalization"
          ],
          "additionalProperties": false
        },
        "chunking": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "max_chars": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "tokenizer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "chunker": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "max_chars",
            "tokenizer",
            "chunker"
          ],
          "additionalProperties": false
        },
        "format": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "dtype": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "encoding": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          },
          "required": [
            "dtype",
            "encoding"
          ],
          "additionalProperties": false
        },
        "source": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "source_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "parse_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "evidence_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "required": [
            "source_digest",
            "parse_revision",
            "evidence_count"
          ],
          "additionalProperties": false
        },
        "vectors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "excerpt_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "embedding": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4096,
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "evidence_id",
              "excerpt_digest",
              "embedding"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "schema",
        "state",
        "model",
        "dimension",
        "preprocessing",
        "chunking",
        "format",
        "source",
        "vectors",
        "reason"
      ],
      "additionalProperties": false,
      "description": "Observed model identity only, never a guessed version. Runtime verifies distinct model name/version, equal dimensions, finite values, fixed source revision, vector count and exact bundled evidence/excerpt digests. Matching metadata alone does not mean an index is ready.",
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "missing"
              }
            }
          },
          "then": {
            "properties": {
              "model": {
                "type": "null"
              },
              "dimension": {
                "type": "null"
              },
              "preprocessing": {
                "type": "null"
              },
              "chunking": {
                "type": "null"
              },
              "format": {
                "type": "null"
              },
              "source": {
                "type": "null"
              },
              "vectors": {
                "maxItems": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "model": {
                "type": "object"
              },
              "dimension": {
                "type": "integer"
              },
              "preprocessing": {
                "type": "object"
              },
              "chunking": {
                "type": "object"
              },
              "format": {
                "type": "object"
              },
              "source": {
                "type": "object"
              },
              "reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
