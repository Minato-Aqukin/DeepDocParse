{
  "name": "deepdocparse",
  "private": true,
  "version": "0.0.0",
  "description": "DeepDocParse monorepo — 面向技术手册与论文的多模态 PDF 检索工作台",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "contracts:gen": "python3 packages/contracts/scripts/generate.py",
    "contracts:check": "python3 packages/contracts/scripts/generate.py --check",
    "web:dev": "npm run dev --workspace deepdocparse-web-frontend",
    "web:build": "npm run build --workspace deepdocparse-web-frontend",
    "web:test": "npm run test:unit --workspace deepdocparse-web-frontend"
  },
  "engines": {
    "node": ">=22"
  }
}
