# 本机开发的环境变量样板。
#
#   cp infra/env/dev.env.example infra/env/dev.env
#   # 填好下面三个必填项（compose 里用 :? 语法，不填直接拒绝启动）
#   docker compose -f infra/compose/compose.dev.yml --env-file infra/env/dev.env up -d
#
# **三个必填项没有默认值是有意的。** 占位密钥跑起来的话鉴权形同虚设，
# 而运行时不会有任何报错 —— 这个项目在 JWT_SECRET 与 SERVICE_TOKEN 上
# 各踩过一次。生成方法：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# 签发用户会话。**必须 >= 32 字节**，否则 control-api 拒绝启动
JWT_SECRET=

# 服务间凭据。control-api / corpus-api / model-gateway / mcp **四处必须一致**
SERVICE_TOKEN=

# 对象存储密钥。默认值 minioadmin 会被 control-api 拒绝
OBJECT_SECRET_KEY=

# ---- 下面都有默认值，按需覆盖 ----

# PostgreSQL 的超级用户口令（迁移与 MCP 用它连）
POSTGRES_PASSWORD=ddp
# 语料侧连库用的角色口令（database/control/0002_roles.sql 建的 ddp_corpus）
CORPUS_DB_PASSWORD=ddp

OBJECT_ACCESS_KEY=minioadmin
# **浏览器可达**的对象存储地址 —— 预签名 URL 用它签。
# 用容器内地址（minio:9000）的话，浏览器一访问就是 DNS 失败，
# 而这只在真部署里才暴露
OBJECT_PUBLIC_ENDPOINT=127.0.0.1:19000

# 入口对外可达的地址，拼稳定文件 URL 用
PUBLIC_BASE_URL=http://127.0.0.1:8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 模型注册表档位（infra/registry/ 下的文件名）。
# 无 GPU 用 models.cpu.yaml（只注册 borndigital），有 N 卡用 models.yaml
MODELS_CONFIG=models.cpu.yaml
DEFAULT_PARSE_ENGINE=borndigital

# 国内构建加速
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
# GOPROXY=https://goproxy.cn,direct

WORKER_REPLICAS=1
